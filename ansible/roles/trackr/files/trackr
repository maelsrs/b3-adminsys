#!/usr/bin/python3
"""TrackR (maquette) : suivi des livraisons, en HTTP, adossé à PostgreSQL.

GET  /health      -> ok si la base répond
GET  /livraisons  -> liste JSON
POST /livraisons  -> {"camion": "...", "destination": "..."}

Connexion par socket Unix en authentification « peer » : le compte système trackr est le rôle
PostgreSQL trackr, aucun mot de passe à stocker.
"""
import json
import os
import signal
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import psycopg2

DB = os.environ.get("TRACKR_DB", "trackr")
PORT = int(os.environ.get("TRACKR_PORT", "8080"))
STATE = os.environ.get("STATE_DIRECTORY", "/var/lib/trackr")


def db():
    return psycopg2.connect(dbname=DB)


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body):
        data = json.dumps(body, default=str).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        try:
            with db() as c, c.cursor() as cur:
                if self.path == "/health":
                    cur.execute("SELECT 1")
                    return self.reply(200, {"etat": "ok"})
                if self.path == "/livraisons":
                    cur.execute("SELECT id, camion, destination, cree_le FROM livraisons ORDER BY id")
                    cols = [d[0] for d in cur.description]
                    return self.reply(200, [dict(zip(cols, r)) for r in cur.fetchall()])
            self.reply(404, {"erreur": "inconnu"})
        except psycopg2.Error as e:
            self.reply(503, {"erreur": str(e).strip()})

    def do_POST(self):
        if self.path != "/livraisons":
            return self.reply(404, {"erreur": "inconnu"})
        try:
            n = int(self.headers.get("Content-Length", 0))
            l = json.loads(self.rfile.read(n))
            with db() as c, c.cursor() as cur:
                cur.execute("INSERT INTO livraisons (camion, destination) VALUES (%s, %s) RETURNING id",
                            (l["camion"], l["destination"]))
                self.reply(201, {"id": cur.fetchone()[0]})
        except (ValueError, KeyError) as e:
            self.reply(400, {"erreur": repr(e)})
        except psycopg2.Error as e:
            self.reply(503, {"erreur": str(e).strip()})

    def log_message(self, fmt, *args):  # vers journald (stderr), sans l'horodatage en double
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


def main():
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    # SIGTERM : arrêt propre ; SIGHUP : « relis ta config » (ici, juste une trace)
    signal.signal(signal.SIGTERM, lambda *_: (srv.server_close(), sys.exit(0)))
    signal.signal(signal.SIGHUP, lambda *_: print("SIGHUP reçu", file=sys.stderr, flush=True))
    with open(os.path.join(STATE, "demarrage.pid"), "w") as f:
        f.write(str(os.getpid()))
    print(f"TrackR écoute sur :{PORT}, base {DB}", file=sys.stderr, flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
