# Géré par Ansible (rôle trackr) : le quoi. Le quand est dans pg-backup.timer
[Unit]
Description=Sauvegarde de la base TrackR (pg_dump)
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Environment=BACKUP_DIR={{ trackr_backup_dir }} BACKUP_DAYS={{ trackr_backup_days }}
ExecStart=/usr/local/bin/pg-backup
ProtectSystem=strict
ReadWritePaths={{ trackr_backup_dir }}
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
