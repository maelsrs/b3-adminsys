# Géré par Ansible (rôle trackr). Clés expliquées dans trackr.env.example du dépôt TrackR
TRACKR_LISTEN=0.0.0.0
TRACKR_PORT={{ trackr_port }}
TRACKR_DB={{ trackr_db_url }}
TRACKR_DEMO={{ 'yes' if trackr_demo else 'no' }}
# Signe les sessions : sans lui, tout le monde est déconnecté à chaque redémarrage
TRACKR_SECRET={{ vault_trackr_secret }}

# Comptes AD, membres de {{ trackr_ad_group }} seulement ; LDAPS, certificats des DC vérifiés
TRACKR_AUTH=ad
TRACKR_AD_DOMAIN={{ ad_domain }}
TRACKR_AD_SERVERS={{ trackr_ad_servers | map('regex_replace', '$', '.' ~ ad_domain) | join(',') }}
TRACKR_AD_GROUP={{ trackr_ad_group }}
TRACKR_AD_TLS=ldaps
TRACKR_AD_CA_FILE=/etc/trackr/ad-ca.crt
