# Géré par Ansible (rôle supervision, MC15)
route:
  receiver: equipe-it
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  # Une panne qui dure n'est rappelée que toutes les 4 h : trop d'alertes, plus personne ne lit
  repeat_interval: 4h

receivers:
  - name: equipe-it
    # Toujours : le journal de mon01 (journalctl -u alertes), même sans Internet
    webhook_configs:
      - url: http://127.0.0.1:9095/
        send_resolved: true
{% if supervision_discord_webhook %}
    discord_configs:
      - webhook_url: "{{ supervision_discord_webhook }}"
        send_resolved: true
        title: '{{ "{{" }} if eq .Status "firing" {{ "}}" }}🔴{{ "{{" }} else {{ "}}" }}✅{{ "{{" }} end {{ "}}" }} {{ "{{" }} .CommonLabels.alertname {{ "}}" }}'
        message: '{{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} .Annotations.resume {{ "}}" }}{{ "\n" }}{{ "{{" }} end {{ "}}" }}'
{% endif %}
